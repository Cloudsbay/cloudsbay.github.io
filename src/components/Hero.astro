---
// Hero.astro - Minimalist pure typography in the white cloud room
---

<section class="hero-room">
  <div class="hero-inner">
    <span class="hero-eyebrow">Cloudsbay</span>
    
    <h1 class="hero-headline">
      We like to solve problems building sustainable and scalable solutions.
    </h1>

    <p class="hero-scroll-hint">
      <span class="hint-line"></span>
      <span class="hint-text">Scroll through the clouds</span>
    </p>
  </div>
</section>

<style>
  .hero-room {
    min-height: 85vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: 6rem 3rem 8rem;
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
    position: relative;
  }

  .hero-inner {
    max-width: 920px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero-eyebrow {
    font-family: var(--font-sans);
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--color-ink-muted);
    letter-spacing: -0.01em;
    margin-bottom: 2.5rem;
    display: block;
  }

  .hero-headline {
    font-family: var(--font-sans);
    font-size: clamp(2.75rem, 6.5vw, 5.25rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.04em;
    color: var(--color-ink);
    margin: 0 0 4.5rem;
  }

  .hero-scroll-hint {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    font-family: var(--font-text);
    font-size: 0.875rem;
    color: var(--color-ink-subtle);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .hint-line {
    width: 48px;
    height: 1px;
    background: var(--color-ink-subtle);
  }

  @media (max-width: 768px) {
    .hero-room {
      padding: 4rem 1.5rem 6rem;
      min-height: 75vh;
    }

    .hero-eyebrow {
      margin-bottom: 1.75rem;
    }

    .hero-headline {
      margin-bottom: 3rem;
    }
  }
</style>