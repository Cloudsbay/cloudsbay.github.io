<footer>
  <div class="footer-container">
    <div class="footer-links-area">
      <!-- Add other important links here -->
      <div class="important-links">
        <h4>Quick Links</h4>
        <ul>
          <li><a href="/privacy">Privacy Policy</a></li>
          <li><a href="/terms">Terms of Service</a></li>
          <li><a href="/support">Support</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-card">
      <div class="footer-logo">Cloudsbay</div>
      <div class="footer-card-links">
        <a href="/" class="footer-link">Home</a>
        <a href="/blogs" class="footer-link">Blogs</a>
        <a href="/about" class="footer-link">About</a>
      </div>
    </div>
  </div>
  <div class="footer-bottom">
    &copy; 2025 Cloudsbay. All rights reserved.
  </div>
</footer>

<style>
  :root {
    --primary-color: #F21905;
    --text: #ffffff;
    --card-bg: #D9D9D9;
  }

  footer {
    background-color: #000;
    color: var(--text);
    font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
    padding: 2rem 4rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .footer-container {
    display: flex;
    justify-content: space-between;
    align-items: stretch;
    max-width: 1200px;
    margin: 0 auto;
    gap: 2rem;
  }

  .footer-links-area {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .important-links h4 {
    margin-bottom: 0.75rem;
    font-size: 1.125rem;
    color: var(--text);
  }

  .important-links ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .important-links li {
    margin-bottom: 0.5rem;
  }

  .important-links a {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .important-links a:hover {
    color: var(--primary-color);
  }

  .footer-card {
    background-color: var(--card-bg);
    color: #000;
    padding: 1.5rem;
    width: 250px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.15);
  }

  .footer-logo {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--primary-color);
    margin-bottom: 1.25rem;
    text-align: right;
  }

  .footer-card-links {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: flex-end;
  }

  .footer-card-links .footer-link {
    text-decoration: none;
    font-size: 1rem;
    font-weight: 500;
    color: #000;
    position: relative;
    transition: color 0.2s ease;
  }

  .footer-card-links .footer-link:hover {
    color: var(--primary-color);
  }

  .footer-bottom {
    text-align: center;
    margin-top: 2rem;
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.6);
  }

  @media (max-width: 768px) {
    .footer-container {
      flex-direction: column-reverse;
      align-items: center;
    }

    .footer-card {
      width: 100%;
      align-items: center;
    }

    .footer-card-links {
      align-items: center;
    }

    .footer-logo {
      text-align: center;
    }

    .footer-links-area {
      align-items: center;
      text-align: center;
    }
  }
</style>