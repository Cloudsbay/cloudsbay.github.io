---
// Footer.astro - Glassmorphic footer in the cloud studio
const year = new Date().getFullYear();
---

<footer class="studio-footer">
  <div class="footer-glass glass-card">
    <div class="footer-top">
      <div class="brand-line">
        <span class="brand-title">Cloudsbay</span>
        <p class="brand-desc">
          Sustainable and scalable solutions derived from relentless curiosity. Bringing nature and technology together to restore the living Earth.
        </p>
      </div>

      <div class="footer-nav">
        <div class="nav-group">
          <span class="group-title">Navigation</span>
          <a href="/#curiosity">Curiosity</a>
          <a href="/#earth">Earth & Trees</a>
          <a href="/about">About</a>
          <a href="/blogs">Writing</a>
        </div>

        <div class="nav-group">
          <span class="group-title">Contact</span>
          <a href="mailto:enquire@cloudsbay.com">enquire@cloudsbay.com</a>
          <a href="https://github.com/cloudsbay" target="_blank" rel="noopener noreferrer">GitHub</a>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <span class="copy">&copy; {year} Cloudsbay. Plain and simple.</span>
      <span class="pledge">A home to humans, animals, and all creatures.</span>
    </div>
  </div>
</footer>

<style>
  .studio-footer {
    width: 100%;
    padding: 2rem 1.5rem 4rem;
    position: relative;
    z-index: 10;
  }

  .footer-glass {
    max-width: 1200px;
    margin: 0 auto;
    padding: 4.5rem;
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  .footer-top {
    display: flex;
    justify-content: space-between;
    gap: 4rem;
  }

  .brand-line {
    max-width: 480px;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .brand-title {
    font-family: var(--font-sans);
    font-size: 1.35rem;
    font-weight: 500;
    color: var(--color-ink);
    letter-spacing: -0.02em;
  }

  .brand-desc {
    font-family: var(--font-text);
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-ink-muted);
  }

  .footer-nav {
    display: flex;
    gap: 4.5rem;
  }

  .nav-group {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .group-title {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-ink-subtle);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }

  .nav-group a {
    font-family: var(--font-text);
    font-size: 1rem;
    color: var(--color-ink-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .nav-group a:hover {
    color: var(--color-ink);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-text);
    font-size: 0.875rem;
    color: var(--color-ink-subtle);
    padding-top: 2rem;
    border-top: 1px solid rgba(0, 0, 0, 0.05);
  }

  .pledge {
    color: var(--color-ink-muted);
    font-style: italic;
  }

  @media (max-width: 768px) {
    .studio-footer {
      padding: 1rem 1rem 3rem;
    }

    .footer-glass {
      padding: 2.5rem 1.75rem;
      border-radius: 24px;
      gap: 3rem;
    }

    .footer-top {
      flex-direction: column;
      gap: 2.5rem;
    }

    .footer-nav {
      gap: 3rem;
    }

    .footer-bottom {
      flex-direction: column;
      gap: 1rem;
    }
  }
</style>