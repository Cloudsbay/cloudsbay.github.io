---
// CloudRoom.astro - Literal volumetric cloud & fog simulation in a pure white studio room
---

<div class="studio-room" aria-hidden="true">
  <!-- The White Infinity Studio Background -->
  <div class="studio-walls"></div>
  
  <!-- Deep Background Clouds Canvas (behind text) -->
  <canvas id="cloudCanvasBack" class="cloud-canvas canvas-back"></canvas>

  <!-- Foreground Fog Canvas (floating over text) -->
  <canvas id="cloudCanvasFront" class="cloud-canvas canvas-front"></canvas>

  <!-- Soft Ambient Light Bloom -->
  <div class="studio-bloom"></div>
</div>

<script>
  // High-fidelity Volumetric Cloud & Fog Simulation
  function initCloudStudio() {
    const canvasBack = document.getElementById('cloudCanvasBack') as HTMLCanvasElement | null;
    const canvasFront = document.getElementById('cloudCanvasFront') as HTMLCanvasElement | null;
    if (!canvasBack || !canvasFront) return;

    const ctxBack = canvasBack.getContext('2d');
    const ctxFront = canvasFront.getContext('2d');
    if (!ctxBack || !ctxFront) return;

    let width = 0;
    let height = 0;
    let dpr = Math.min(window.devicePixelRatio || 1, 2);

    // Generate procedural volumetric cloud puff sprites offscreen for maximum 60fps performance
    const spriteSizes = [400, 550, 700];
    const sprites: HTMLCanvasElement[] = [];

    function generateCloudSprites() {
      sprites.length = 0;
      spriteSizes.forEach((size, idx) => {
        const offCanvas = document.createElement('canvas');
        offCanvas.width = size;
        offCanvas.height = size;
        const offCtx = offCanvas.getContext('2d');
        if (!offCtx) return;

        const center = size / 2;
        const radius = size / 2;

        // Realistic cloud gradient: dense bright core, soft grey/mist attenuation, feathered falloff
        const grad = offCtx.createRadialGradient(
          center - radius * 0.1, center - radius * 0.1, radius * 0.05,
          center, center, radius
        );

        if (idx === 0) {
          // Soft cumulus dense puff
          grad.addColorStop(0, 'rgba(255, 255, 255, 0.95)');
          grad.addColorStop(0.35, 'rgba(235, 240, 246, 0.7)');
          grad.addColorStop(0.65, 'rgba(215, 225, 235, 0.35)');
          grad.addColorStop(0.85, 'rgba(225, 232, 240, 0.12)');
          grad.addColorStop(1, 'rgba(255, 255, 255, 0)');
        } else if (idx === 1) {
          // Ethereal drifting fog bank
          grad.addColorStop(0, 'rgba(250, 252, 255, 0.9)');
          grad.addColorStop(0.3, 'rgba(228, 236, 245, 0.6)');
          grad.addColorStop(0.6, 'rgba(205, 218, 230, 0.28)');
          grad.addColorStop(0.85, 'rgba(220, 230, 240, 0.08)');
          grad.addColorStop(1, 'rgba(255, 255, 255, 0)');
        } else {
          // Broad atmospheric wisp
          grad.addColorStop(0, 'rgba(255, 255, 255, 0.85)');
          grad.addColorStop(0.4, 'rgba(232, 238, 246, 0.45)');
          grad.addColorStop(0.7, 'rgba(210, 222, 235, 0.2)');
          grad.addColorStop(0.9, 'rgba(230, 236, 244, 0.05)');
          grad.addColorStop(1, 'rgba(255, 255, 255, 0)');
        }

        offCtx.fillStyle = grad;
        offCtx.beginPath();
        offCtx.arc(center, center, radius, 0, Math.PI * 2);
        offCtx.fill();

        sprites.push(offCanvas);
      });
    }

    generateCloudSprites();

    interface CloudPuff {
      x: number;
      y: number;
      baseX: number;
      baseY: number;
      z: number; // 0 = back, 1 = mid, 2 = front
      size: number;
      baseSize: number;
      vx: number;
      vy: number;
      opacity: number;
      baseOpacity: number;
      rotation: number;
      vRot: number;
      spriteIdx: number;
      pulsePhase: number;
      pulseSpeed: number;
    }

    const clouds: CloudPuff[] = [];
    const NUM_CLOUDS_BACK = 26;
    const NUM_CLOUDS_FRONT = 14;

    function resize() {
      width = window.innerWidth;
      height = window.innerHeight;
      dpr = Math.min(window.devicePixelRatio || 1, 2);

      [canvasBack, canvasFront].forEach((c) => {
        if (!c) return;
        c.width = width * dpr;
        c.height = height * dpr;
        c.style.width = width + 'px';
        c.style.height = height + 'px';
      });

      ctxBack?.scale(dpr, dpr);
      ctxFront?.scale(dpr, dpr);
    }

    function initClouds() {
      clouds.length = 0;
      resize();

      // Deep background and midground clouds
      for (let i = 0; i < NUM_CLOUDS_BACK; i++) {
        const z = Math.random() < 0.6 ? 0 : 1;
        const size = (z === 0 ? 450 : 600) + Math.random() * 350;
        const x = (Math.random() - 0.2) * (width * 1.4);
        const y = (Math.random() - 0.2) * (height * 1.4);

        clouds.push({
          x,
          y,
          baseX: x,
          baseY: y,
          z,
          size,
          baseSize: size,
          vx: (Math.random() - 0.5) * 0.25 - 0.08, // Slow natural leftward drift
          vy: (Math.random() - 0.5) * 0.15,
          opacity: z === 0 ? 0.35 + Math.random() * 0.3 : 0.25 + Math.random() * 0.25,
          baseOpacity: z === 0 ? 0.35 + Math.random() * 0.3 : 0.25 + Math.random() * 0.25,
          rotation: Math.random() * Math.PI * 2,
          vRot: (Math.random() - 0.5) * 0.001,
          spriteIdx: Math.floor(Math.random() * sprites.length),
          pulsePhase: Math.random() * Math.PI * 2,
          pulseSpeed: 0.005 + Math.random() * 0.008
        });
      }

      // Foreground clouds (float in front of the text like physical mist)
      for (let i = 0; i < NUM_CLOUDS_FRONT; i++) {
        const size = 650 + Math.random() * 450;
        const x = (Math.random() - 0.2) * (width * 1.4);
        const y = (Math.random() - 0.2) * (height * 1.4);

        clouds.push({
          x,
          y,
          baseX: x,
          baseY: y,
          z: 2,
          size,
          baseSize: size,
          vx: (Math.random() - 0.5) * 0.35 - 0.12,
          vy: (Math.random() - 0.5) * 0.2,
          opacity: 0.12 + Math.random() * 0.16, // Translucent so text remains crisp and readable
          baseOpacity: 0.12 + Math.random() * 0.16,
          rotation: Math.random() * Math.PI * 2,
          vRot: (Math.random() - 0.5) * 0.0015,
          spriteIdx: Math.floor(Math.random() * sprites.length),
          pulsePhase: Math.random() * Math.PI * 2,
          pulseSpeed: 0.006 + Math.random() * 0.008
        });
      }
    }

    // Scroll & Mouse Tracking
    let targetScrollY = 0;
    let currentScrollY = 0;
    let mouseX = -1000;
    let mouseY = -1000;
    let targetMouseX = -1000;
    let targetMouseY = -1000;

    window.addEventListener('scroll', () => {
      targetScrollY = window.scrollY;
    }, { passive: true });

    window.addEventListener('mousemove', (e) => {
      targetMouseX = e.clientX;
      targetMouseY = e.clientY;
    }, { passive: true });

    window.addEventListener('resize', () => {
      resize();
    }, { passive: true });

    initClouds();

    // Animation Loop
    let animId = 0;
    let isVisible = true;

    document.addEventListener('visibilitychange', () => {
      isVisible = !document.hidden;
      if (isVisible) {
        lastTime = performance.now();
        requestAnimationFrame(render);
      }
    });

    let lastTime = performance.now();

    function render(now: number) {
      if (!isVisible) return;
      const dt = Math.min((now - lastTime) / 1000, 0.1);
      lastTime = now;

      // Smooth scroll interpolation
      currentScrollY += (targetScrollY - currentScrollY) * 0.08;

      // Smooth mouse interpolation
      mouseX += (targetMouseX - mouseX) * 0.06;
      mouseY += (targetMouseY - mouseY) * 0.06;

      if (!ctxBack || !ctxFront) return;

      // Clear both canvases
      ctxBack.clearRect(0, 0, width, height);
      ctxFront.clearRect(0, 0, width, height);

      const totalHeight = Math.max(document.body.scrollHeight, height * 2);

      // Render each cloud puff
      for (let i = 0; i < clouds.length; i++) {
        const c = clouds[i];

        // Update gentle natural drift
        c.x += c.vx * (dt * 60);
        c.y += c.vy * (dt * 60);
        c.rotation += c.vRot * (dt * 60);
        c.pulsePhase += c.pulseSpeed * (dt * 60);

        // Breathing / billowing size pulsation
        const sizeMultiplier = 1 + Math.sin(c.pulsePhase) * 0.08;
        const currentSize = c.baseSize * sizeMultiplier;

        // Parallax speed based on depth layer
        // z: 0 (deep back, slow), 1 (midground), 2 (foreground, fast)
        const parallaxFactor = c.z === 0 ? 0.15 : (c.z === 1 ? 0.35 : 0.65);
        const scrollOffset = currentScrollY * parallaxFactor;

        // Calculate rendered Y position with wrap-around across viewport
        let renderX = c.x;
        let renderY = c.y - scrollOffset;

        // Wrap around horizontally
        const buffer = currentSize * 0.8;
        if (renderX < -buffer) c.x += width + buffer * 2;
        if (renderX > width + buffer) c.x -= width + buffer * 2;

        // Wrap around vertically relative to scroll
        const vSpan = height + buffer * 2;
        const relY = ((renderY + buffer) % vSpan + vSpan) % vSpan - buffer;

        // Mouse disturbance: push clouds gently aside when mouse approaches
        const dx = renderX - mouseX;
        const dy = relY - mouseY;
        const dist = Math.sqrt(dx * dx + dy * dy);
        const mouseRadius = 260;

        if (dist < mouseRadius && dist > 0) {
          const force = (1 - dist / mouseRadius) * 18 * (c.z === 2 ? 1.4 : 0.8);
          c.x += (dx / dist) * force * dt;
          c.y += (dy / dist) * force * dt;
        }

        const targetCtx = c.z === 2 ? ctxFront : ctxBack;
        const sprite = sprites[c.spriteIdx] || sprites[0];

        targetCtx.save();
        targetCtx.translate(renderX, relY);
        targetCtx.rotate(c.rotation);
        targetCtx.globalAlpha = c.opacity;
        targetCtx.drawImage(
          sprite,
          -currentSize / 2,
          -currentSize / 2,
          currentSize,
          currentSize
        );
        targetCtx.restore();
      }

      animId = requestAnimationFrame(render);
    }

    animId = requestAnimationFrame(render);
  }

  // Run when DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCloudStudio);
  } else {
    initCloudStudio();
  }
</script>

<style>
  .studio-room {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  /* Completely white studio infinity room with soft ambient light */
  .studio-walls {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 95% 85% at 50% 30%,
      #ffffff 0%,
      #fafbfc 45%,
      #f3f6f9 85%,
      #eaeff5 100%
    );
    z-index: 0;
  }

  /* Back canvas sits behind all text */
  .canvas-back {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
  }

  /* Front canvas floats in front of text */
  .canvas-front {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 20;
    pointer-events: none;
    mix-blend-mode: normal;
  }

  /* Soft celestial ambient bloom */
  .studio-bloom {
    position: absolute;
    top: -10vh;
    left: 20vw;
    width: 60vw;
    height: 40vh;
    background: radial-gradient(
      ellipse at center,
      rgba(255, 255, 255, 0.95) 0%,
      rgba(240, 246, 254, 0.6) 45%,
      transparent 80%
    );
    filter: blur(80px);
    z-index: 2;
    pointer-events: none;
  }
</style>
