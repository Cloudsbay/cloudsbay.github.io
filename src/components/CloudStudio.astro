        <img src="/tree-3.webp" alt="" class="tree-img rustle-1" loading="lazy" />
      </div>
      <div class="tree-actor tree-fg-4" data-depth="0.42">
        <img src="/tree-4.webp" alt="" class="tree-img rustle-2" loading="lazy" />
      </div>
      <div class="tree-actor tree-fg-5" data-depth="0.46">
        <img src="/tree-1.webp" alt="" class="tree-img rustle-3" loading="lazy" />
      </div>

      <!-- Soft canopy mist weaving through tree crowns -->
      <div class="canopy-mist">
        <img src="/cloud-4.webp" alt="" class="mist-cloud-1" />
