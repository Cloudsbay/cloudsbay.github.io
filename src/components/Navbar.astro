---
// Navbar.astro - Floating glassmorphic navigation in the cloud studio
---

<header class="navbar-wrapper">
  <nav class="navbar-glass" aria-label="Main Navigation">
    <a href="/" class="brand" aria-label="Cloudsbay Homepage">
      Cloudsbay
    </a>

    <div class="nav-links">
      <a href="/#curiosity" class="nav-link">Curiosity</a>
      <a href="/#earth" class="nav-link">Earth & Trees</a>
      <a href="/about" class="nav-link">About</a>
      <a href="/blogs" class="nav-link">Writing</a>
      <a href="/#contact" class="nav-link">Contact</a>
    </div>

    <!-- Minimal Mobile Trigger -->
    <button class="mobile-toggle" aria-label="Toggle navigation menu" id="menuToggle" aria-expanded="false">
      <span class="bar"></span>
      <span class="bar"></span>
    </button>
  </nav>

  <!-- Mobile Menu Dropdown -->
  <div class="mobile-menu" id="mobileMenu">
    <a href="/#curiosity" class="mobile-link">Curiosity</a>
    <a href="/#earth" class="mobile-link">Earth & Trees</a>
    <a href="/about" class="mobile-link">About</a>
    <a href="/blogs" class="mobile-link">Writing</a>
    <a href="/#contact" class="mobile-link">Contact</a>
  </div>
</header>

<script>
  const toggle = document.getElementById('menuToggle');
  const menu = document.getElementById('mobileMenu');

  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!isOpen));
      menu.classList.toggle('active', !isOpen);
      toggle.classList.toggle('open', !isOpen);
    });

    menu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        toggle.setAttribute('aria-expanded', 'false');
        menu.classList.remove('active');
        toggle.classList.remove('open');
      });
    });
  }
</script>

<style>
  .navbar-wrapper {
    position: sticky;
    top: 1.5rem;
    width: 100%;
    z-index: 100;
    display: flex;
    justify-content: center;
    padding: 0 1.5rem;
  }

  .navbar-glass {
    width: 100%;
    max-width: 1100px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.65rem 1.75rem;
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.58) 0%,
      rgba(255, 255, 255, 0.24) 48%,
      rgba(255, 255, 255, 0.45) 82%,
      rgba(255, 255, 255, 0.28) 100%
    );
    backdrop-filter: blur(36px) saturate(200%) brightness(105%);
    -webkit-backdrop-filter: blur(36px) saturate(200%) brightness(105%);
    border: none;
    border-radius: 999px;
    position: relative;
    overflow: hidden;
    box-shadow: 
      0 20px 48px -12px rgba(15, 23, 42, 0.05),
      0 6px 16px -4px rgba(15, 23, 42, 0.02),
      inset 0 1.5px 2.5px 0 rgba(255, 255, 255, 0.9),
      inset 0 -1px 2px 0 rgba(255, 255, 255, 0.2),
      inset 0 0 20px 0 rgba(255, 255, 255, 0.35);
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Liquid Glass Meniscus Upper Highlight */
  .navbar-glass::before {
    content: '';
    position: absolute;
    top: 0;
    left: 4%;
    right: 4%;
    height: 48%;
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.72) 0%,
      rgba(255, 255, 255, 0.08) 75%,
      rgba(255, 255, 255, 0) 100%
    );
    border-radius: 999px 999px 60% 60% / 999px 999px 40% 40%;
    pointer-events: none;
    z-index: 1;
  }

  /* Living Liquid Light Caustic Shimmer */
  .navbar-glass::after {
    content: '';
    position: absolute;
    top: -60%;
    left: -30%;
    width: 160%;
    height: 220%;
    background: radial-gradient(
      ellipse at 40% 40%,
      rgba(255, 255, 255, 0.5) 0%,
      rgba(255, 255, 255, 0.12) 32%,
      transparent 65%
    );
    pointer-events: none;
    z-index: 1;
    animation: liquidCaustic 14s ease-in-out infinite alternate;
  }

  @keyframes liquidCaustic {
    0% {
      transform: translate(-10%, -6%) rotate(0deg) scale(1);
    }
    50% {
      transform: translate(12%, 6%) rotate(1.5deg) scale(1.05);
    }
    100% {
      transform: translate(25%, -6%) rotate(-1deg) scale(0.98);
    }
  }

  .navbar-glass:hover {
    box-shadow: 
      0 24px 54px -12px rgba(15, 23, 42, 0.07),
      0 8px 20px -4px rgba(15, 23, 42, 0.03),
      inset 0 1.5px 2.5px 0 rgba(255, 255, 255, 0.95),
      inset 0 -1px 2px 0 rgba(255, 255, 255, 0.25),
      inset 0 0 24px 0 rgba(255, 255, 255, 0.45);
  }

  .brand {
    font-family: var(--font-sans);
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--color-ink);
    text-decoration: none;
    letter-spacing: -0.02em;
    position: relative;
    z-index: 2;
    padding: 0.35rem 0.6rem;
    border-radius: 999px;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .brand:hover {
    opacity: 0.75;
    transform: translateY(-0.5px);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    position: relative;
    z-index: 2;
  }

  .nav-link {
    font-family: var(--font-text);
    font-size: 0.92rem;
    font-weight: 450;
    color: var(--color-ink-muted);
    text-decoration: none;
    letter-spacing: -0.01em;
    padding: 0.45rem 1.1rem;
    border-radius: 999px;
    position: relative;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-link:hover {
    color: var(--color-ink);
    background: rgba(255, 255, 255, 0.58);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 
      0 4px 14px -2px rgba(0, 0, 0, 0.03),
      inset 0 1px 1.5px rgba(255, 255, 255, 0.95),
      inset 0 -0.5px 1px rgba(255, 255, 255, 0.3);
    transform: translateY(-0.5px);
  }

  /* Mobile Toggle */
  .mobile-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 36px;
    height: 36px;
    background: rgba(255, 255, 255, 0.4);
    border: none;
    border-radius: 50%;
    cursor: pointer;
    padding: 0;
    position: relative;
    z-index: 2;
    transition: background 0.2s ease;
  }

  .mobile-toggle:hover {
    background: rgba(255, 255, 255, 0.7);
  }

  .mobile-toggle .bar {
    width: 18px;
    height: 1.5px;
    background: var(--color-ink);
    transition: transform 0.2s ease;
  }

  .mobile-toggle.open .bar:nth-child(1) {
    transform: translateY(3.25px) rotate(45deg);
  }

  .mobile-toggle.open .bar:nth-child(2) {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  .mobile-menu {
    display: none;
    position: absolute;
    top: calc(100% + 0.75rem);
    left: 1.5rem;
    right: 1.5rem;
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.85) 0%,
      rgba(255, 255, 255, 0.65) 100%
    );
    backdrop-filter: blur(36px) saturate(200%);
    -webkit-backdrop-filter: blur(36px) saturate(200%);
    border: none;
    border-radius: 28px;
    box-shadow: 
      0 24px 50px -12px rgba(0, 0, 0, 0.08),
      inset 0 1.5px 2px 0 rgba(255, 255, 255, 0.95),
      inset 0 0 16px rgba(255, 255, 255, 0.4);
    padding: 1.75rem 2rem;
    flex-direction: column;
    gap: 1.25rem;
    opacity: 0;
    pointer-events: none;
    transform: translateY(-10px);
    transition: all 0.3s ease;
  }

  .mobile-menu.active {
    display: flex;
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .mobile-link {
    font-family: var(--font-sans);
    font-size: 1.15rem;
    color: var(--color-ink);
    text-decoration: none;
  }

  @media (max-width: 768px) {
    .nav-links {
      display: none;
    }
    .mobile-toggle {
      display: flex;
    }
  }
</style>