---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CloudRoom from '../components/CloudRoom.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Cloudsbay",
  description = "We solve problems by building sustainable and scalable solutions. Curiosity is the clue to derive solutions to a problem and we are extremely curious."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Google Sans & Google Sans Text -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Google+Sans:ital,wght@0,400;0,500;0,700;1,400&family=Google+Sans+Text:ital,wght@0,400;0,500;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- The Literal Cloud & Studio Fog Environment -->
    <CloudRoom />

    <!-- Text and Structure floating in the cloud room -->
    <div class="content-wrapper">
      <Navbar />
      <main id="main-content">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>

<style is:global>
  :root {
    --font-sans: 'Google Sans', 'Google Sans Text', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    --font-text: 'Google Sans Text', 'Google Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;

    --color-ink: #111827;
    --color-ink-muted: #4b5563;
    --color-ink-subtle: #9ca3af;
    --color-white: #ffffff;

    --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
  }

  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
    background-color: #ffffff;
    color: var(--color-ink);
  }

  body {
    font-family: var(--font-text);
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--color-ink);
    background-color: #ffffff;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    overflow-x: hidden;
    min-height: 100vh;
  }

  /* Content wrapper sits between background clouds (z:1) and foreground mist (z:20) */
  .content-wrapper {
    position: relative;
    z-index: 10;
    width: 100%;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
    width: 100%;
  }

  /* Accessible focus rings */
  a:focus-visible,
  button:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 4px;
  }

  /* Selection */
  ::selection {
    background: rgba(200, 220, 240, 0.5);
    color: var(--color-ink);
  }
</style>